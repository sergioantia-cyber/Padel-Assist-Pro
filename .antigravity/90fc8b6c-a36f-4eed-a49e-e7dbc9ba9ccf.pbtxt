            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- Inserci\303\263n de reserva: Usuarios autenticados"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CREATE POLICY \"Authenticated users can create bookings\" "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "ON bookings FOR INSERT "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "WITH CHECK (auth.uid() = user_id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ===================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 6. FUNCI\303\223N DE DISPONIBILIDAD HORARIA (SECURITY DEFINER)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ===================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE OR REPLACE FUNCTION get_available_slots("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    p_court_id UUID,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    p_date DATE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    p_slot_duration_minutes INT DEFAULT 90"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RETURNS TABLE (slot_start TIMESTAMPTZ, slot_end TIMESTAMPTZ, is_available BOOLEAN) "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "LANGUAGE plpgsql"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "SECURITY DEFINER"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "AS $$"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "DECLARE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    club_open TIME := \'07:00:00\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    club_close TIME := \'23:00:00\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    curr_slot_start TIMESTAMPTZ;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    curr_slot_end TIMESTAMPTZ;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "BEGIN"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    curr_slot_start := (p_date + club_open)::TIMESTAMPTZ;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    WHILE (curr_slot_start + (p_slot_duration_minutes || \' minutes\')::INTERVAL) <= (p_date + club_close)::TIMESTAMPTZ LOOP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        curr_slot_end := curr_slot_start + (p_slot_duration_minutes || \' minutes\')::INTERVAL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        RETURN QUERY"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        SELECT "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            curr_slot_start,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            curr_slot_end,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            NOT EXISTS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                SELECT 1 FROM bookings b"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                WHERE b.court_id = p_court_id"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  AND b.status IN (\'confirmed\', \'pending_payment\')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  AND (b.start_time < curr_slot_end AND b.end_time > curr_slot_start)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        curr_slot_start := curr_slot_end;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    END LOOP;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "END;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "$$;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
          }
        }
        absolute_uri: "file:///src/db/schema.sql"
      }
    }
