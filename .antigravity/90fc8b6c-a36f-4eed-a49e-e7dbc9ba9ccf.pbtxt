"-0.01em\", \"fontWeight\": \"700\" }], \"label-numeric-lg\": [\"22px\", { \"lineHeight\": \"26px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"label-numeric-md\": [\"16px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"500\" }], \"headline-xl\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.03em\", \"fontWeight\": \"800\" }], \"headline-lg-mobile\": [\"24px\", { \"lineHeight\": \"30px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"700\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100vw;margin:0;padding:0;background-color:#0f131c;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-body-md text-on-surface flex flex-col min-h-screen antialiased selection:bg-primary-container selection:text-on-primary-container\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface-dim/85 backdrop-blur-xl shadow-[0_1px_12px_rgba(0,0,0,0.5)] pt-safe\"><div class=\"h-16 px-margin flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0 flex-1\"><img alt=\"Padel Assist Logo\" class=\"h-8 w-auto object-contain shrink-0\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBTcLzVWuV9Pmp8jS1KFA6igMgateNGc2EVpKfH_x6_XYlpldSMwLVboS0R7F6uudnpJWwy3MecOZ19TEt5olh_alcMGcfFeykSTn0t3B7bYrWB-jioiw4Dc3u_SjW6PlVhGZ0OWB8cMZaqcpv7TEy5QyRXK42tmziASoql8aJUHUu92XqpgzouYa29UnNCICgXKu64b09kJkFVskykEQqycm5LHlTHWfHuf1TF1mX07fY6fjSN5c4R\"/><div class=\"flex flex-col min-w-0 justify-center\"><div class=\"flex items-center gap-space-xs\"><span class=\"font-headline-md text-headline-md text-on-surface tracking-tight truncate\">Padel Assist</span><span class=\"font-label-tag text-label-tag px-space-xs py-0.5 rounded-full bg-surface-container-high text-primary tracking-wider uppercase shrink-0\">Pro</span></div><div class=\"flex items-center gap-1.5 mt-0.5\"><span class=\"relative flex h-2 w-2\"><span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span><span class=\"relative inline-flex rounded-full h-2 w-2 bg-primary\"></span></span><span class=\"font-label-tag text-label-tag text-on-surface-variant truncate\">Abierto hoy hasta 11:00 PM</span></div></div></div><div class=\"flex items-center gap-space-sm shrink-0\"><span class=\"sr-only\">Mis Partidos</span><button class=\"relative p-1 rounded-full focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px] min-w-[44px] flex items-center justify-center transition-transform active:scale-95\" type=\"button\"><img alt=\"Profile\" class=\"w-8 h-8 rounded-full object-cover shadow-[0_0_12px_rgba(78,222,163,0.35)]\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAoQl5X_m2cV9bRK7RlnPofFbj31grok4OcvQMhxbj97bNO-T2O68G0UZrYP-AHwkLyL_fRO58jKMvAQ0xbn2TLcGTR1muCm7QhwfiL9M-HbviGaxeqFFYUGi_4-ZzPgIpibfrIIyUgfq2Z_97lo08PoZP32Kve65N4-Fxeh7KILLPamE6jxXT_3Y4HCfNUKZTZ-YuhHB0HZG526gv9NW02LJPREO7WsPBJBoTgvbhlf3Oj7QZyyy9R\"/><span class=\"absolute bottom-1 right-1 w-2.5 h-2.5 bg-primary rounded-full\"></span></button></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-margin pt-16 pb-28 bg-surface\"><div class=\"flex flex-col w-full relative\">\n<!-- Toast Flotante Din\303\241mico -->\n<aside aria-live=\"polite\" class=\"fixed top-20 left-4 right-4 z-50 transform -translate-y-8 opacity-0 pointer-events-none transition-all duration-300 ease-out flex items-center justify-between gap-space-sm p-space-md rounded-xl bg-surface-container-high shadow-xl shadow-surface-container-lowest/80\" id=\"toast-notification\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-primary text-[18px]\">check_circle</span>\n</div>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-headline-md text-body-md text-on-surface font-semibold truncate\">\302\241Enlace copiado!</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant truncate\">Enlace de partido copiado al portapapeles.</span>\n</div>\n</div>\n<button class=\"p-1 rounded-full text-on-surface-variant hover:text-on-surface transition-colors min-w-[32px] min-h-[32px] flex items-center justify-center\" onclick=\"hideToast()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">close</span>\n</button>\n</aside>\n<!-- Control de Pesta\303\261as / Segmented Control -->\n<section aria-label=\"Filtro de partidos\" class=\"w-full mb-space-lg\">\n<div class=\"grid grid-cols-3 p-1 rounded-xl bg-surface-container-low shadow-sm\">\n<button class=\"relative py-2.5 px-space-xs rounded-lg font-label-tag text-label-tag text-on-primary bg-primary shadow-sm flex items-center justify-center gap-1.5 transition-all duration-200\" type=\"button\">\n<span class=\"truncate\">Pr\303\263ximos</span>\n<span class=\"px-1.5 py-0.5 rounded-full bg-on-primary-container text-primary-fixed font-label-numeric-sm text-label-numeric-sm\">2</span>\n</button>\n<button class=\"py-2.5 px-space-xs rounded-lg font-label-tag text-label-tag text-on-surface-variant hover:text-on-surface transition-colors duration-200 flex items-center justify-center\" type=\"button\">\n<span class=\"truncate\">Completados</span>\n</button>\n<button class=\"py-2.5 px-space-xs rounded-lg font-label-tag text-label-tag text-on-surface-variant hover:text-on-surface transition-colors duration-200 flex items-center justify-center\" type=\"button\">\n<span class=\"truncate\">Cancelados</span>\n</button>\n</div>\n</section>\n<!-- Contenedor Principal de Partidos -->\n<div class=\"flex flex-col gap-space-lg\">\n<!-- Tarjeta 1: Hero Match Card (Esperando Comprobante) -->\n<article class=\"relative flex flex-col w-full rounded-xl bg-surface-container shadow-xl overflow-hidden\">\n<!-- Glow ambiental decorativo -->\n<div class=\"absolute -top-16 -right-16 w-44 h-44 rounded-full bg-primary/10 blur-3xl pointer-events-none\"></div>\n<!-- Banner de Cuenta Regresiva -->\n<header class=\"relative px-space-md py-space-sm bg-gradient-to-r from-on-primary-container to-surface-container-high flex items-center justify-between gap-space-xs\">\n<div class=\"flex items-center gap-space-xs min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[18px] shrink-0\">timer</span>\n<span class=\"font-headline-md text-body-sm text-primary font-bold tracking-tight truncate\">Tu partido empieza en 4h 25m</span>\n</div>\n<div class=\"flex items-center gap-1 shrink-0 px-2 py-0.5 rounded-full bg-surface-container-highest\">\n<span class=\"relative flex h-2 w-2\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-primary\"></span>\n</span>\n<span class=\"font-label-numeric-sm text-label-numeric-sm text-primary\">HOY</span>\n</div>\n</header>\n<!-- Portada Visual de la Cancha -->\n<div class=\"relative w-full h-36 bg-surface-container-highest overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Futuristic indoor padel court with dark carbon turf, glowing neon green illumination, panoramic tempered glass walls, and tournament net under dramatic sports spotlights.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCn-FcUBWiRr8UmPwrTqf7DnGKgSrS5nNw5MHR0LWS_q6OUdI839hbhEqOEvpAQqHrrtWilEpU46IX8p34eNDKhDFRV1slzIqujdm39-M26abt5ZRVbjSLBsbRsejoyGCUh8NLqcz6iXMmlT2EAhSV9oK3J2DDLeFcda_ztkv2mwFa91Fj7Yjyvm0tNYJVlEy5MuKppPfFmBrq9b_sr0yheBnWmG6qDZhEYvZAfmZ7j3i6y2dxxKKV6\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container via-surface-container/60 to-transparent\"></div>\n<div class=\"absolute bottom-3 left-space-md right-space-md flex items-end justify-between gap-space-xs\">\n<div class=\"min-w-0\">\n<span class=\"px-2 py-0.5 rounded-full bg-surface-container-lowest/80 backdrop-blur-md text-primary font-label-tag text-label-tag tracking-wider uppercase inline-block mb-1\">\n              Pista Principal\n            </span>\n<h2 class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface truncate\">\n              Pista Central Panor\303\241mica\n            </h2>\n</div>\n<!-- Badge de Estado Pendiente -->\n<span class=\"shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-container/20 text-secondary font-label-tag text-label-tag font-semibold shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n            Esperando Pago\n          </span>\n</div>\n</div>\n<!-- Datos de Fecha, Duraci\303\263n y Costo -->\n<div class=\"p-space-md flex flex-col gap-space-md\">\n<div class=\"grid grid-cols-2 gap-space-sm p-space-sm rounded-lg bg-surface-container-low\">\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-tag text-label-tag text-on-surface-variant flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">schedule</span> Horario\n            </span>\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface font-bold truncate mt-0.5\">\n              19:30 - 21:00\n            </span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Duraci\303\263n: 90 min</span>\n</div>\n<div class=\"flex flex-col min-w-0 text-right\">\n<span class=\"font-label-tag text-label-tag text-on-surface-variant flex items-center justify-end gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">payments</span> Saldo Pendiente\n            </span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-secondary font-extrabold truncate mt-0.5\">\n              $28.00\n            </span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Transferencia directa</span>\n</div>\n</div>\n<!-- Acciones R\303\241pidas -->\n<div class=\"flex flex-col gap-space-xs pt-1\">\n<button class=\"w-full py-3 px-space-md rounded-xl bg-gradient-to-r from-primary-container to-secondary-container text-on-primary-container font-headline-md text-body-lg font-bold flex items-center justify-center gap-space-sm shadow-lg shadow-primary-container/20 active:scale-[0.98] transition-transform\" onclick=\"openPaymentDrawer()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">upload_file</span>\n            Subir Comprobante de Pago\n          </button>\n<div class=\"grid grid-cols-2 gap-space-xs mt-1\">\n<button class=\"py-2.5 px-space-sm rounded-xl bg-surface-container-high text-on-surface hover:bg-surface-bright active:scale-[0.98] transition-all flex items-center justify-center gap-1.5 font-label-tag text-label-tag\" onclick=\"triggerShareToast()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">share</span>\n              Invitar Jugadores\n            </button>\n<button class=\"py-2.5 px-space-sm rounded-xl bg-surface-container-low text-error hover:bg-error-container/20 active:scale-[0.98] transition-all flex items-center justify-center gap-1 font-label-tag text-label-tag\" onclick=\"openCancelModal()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">event_busy</span>\n              Cancelar Turno\n            </button>\n</div>\n</div>\n</div>\n</article>\n<!-- Tarjeta 2: Reserva Confirmada & Pagada -->\n<article class=\"relative flex flex-col w-full rounded-xl bg-surface-container shadow-lg overflow-hidden\">\n<div class=\"p-space-md flex flex-col gap-space-sm\">\n<!-- Header de la tarjeta -->\n<div class=\"flex items-start justify-between gap-space-xs\">\n<div class=\"min-w-0\">\n<div class=\"flex items-center gap-1.5 mb-1\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\">verified</span>\n<span class=\"font-label-tag text-label-tag text-primary uppercase tracking-wider\">Confirmado &amp; Pagado</span>\n</div>\n<h2 class=\"font-headline-md text-headline-md text-on-surface truncate\">\n              Pista Techada Indoor 2\n            </h2>\n<div class=\"flex items-center gap-space-xs text-on-surface-variant mt-0.5\">\n<span class=\"material-symbols-outlined text-[16px]\">calendar_month</span>\n<span class=\"font-label-numeric-sm text-label-numeric-sm text-on-surface\">Viernes 17 Oct - 18:00 (60 min)</span>\n</div>\n</div>\n<span class=\"p-2 rounded-xl bg-surface-container-high text-primary flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">sports_tennis</span>\n</span>\n</div>\n<!-- Slot de Jugadores Inscritos -->\n<div class=\"pt-space-sm mt-space-xs bg-surface-container-low rounded-xl p-space-sm\">\n<div class=\"flex items-center justify-between mb-space-sm\">\n<span class=\"font-label-tag text-label-tag text-on-surface-variant tracking-wider uppercase\">\n              Jugadores Confirmados (3/4)\n            </span>\n<span class=\"font-body-sm text-body-sm text-primary font-semibold\">1 espacio libre</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<!-- Avatares de Jugadores -->\n<div class=\"flex items-center -space-x-2 overflow-hidden py-1\">\n<div class=\"relative group\">\n<img class=\"w-10 h-10 rounded-full object-cover shadow-md\" data-alt=\"Portrait photo of a young male padel player with sporty athletic headband smiling against dark court background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAcTNpVmY5NswhPdvwZRtiv1UKz54_Jw6BjrJuGQyFZd8Q6gs72EQhXqBLInbYuPxB8KCgn4iNJEm83NRHcCNwTxQazMPt_7vi5kS_KC40drCrUxgYRjCf9rsDHF1z89N14zsBvGW6fSyG8vskgyU_KoncUugYeOU8iaJB8twEarOwP0bOBYUwlEaeU6qOfovUpaOTBMy1rsJDrNmYwhcLswj6jHhx2MhQxPUUX0T6Uw1tHmcwRa915\"/>\n<span class=\"absolute bottom-0 right-0 w-3 h-3 rounded-full bg-primary flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[8px] text-on-primary\">star</span>\n</span>\n</div>\n<img class=\"w-10 h-10 rounded-full object-cover shadow-md\" data-alt=\"Portrait of an energetic female padel player wearing an emerald sports jersey with braided hair.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCbzCrLZpJcq_itFyNVbVKrn2ou39Ohqxl-Bgig7YFkdtwkkSmf1XfAhnbseuFaT6msIvtFFf9-t1DSBJsFmU90WRcEuGJzhCtIDnzcLVztEL7s55mWNvqIX-GYCAqNY9mNCkfp93-oTjE1QWjEtcuVYF7YvThbqJO9SmiOUyGirey7EHAWK2Gig9MxrQvsdY4NXNgNBPPJ7EZ1poqxIw6X41qnCKQirXZl2hUkKnkNTG-xXFBY7Dw6\"/>\n<img class=\"w-10 h-10 rounded-full object-cover shadow-md\" data-alt=\"Headshot of a smiling middle-aged male tennis and padel player in dark navy sports apparel.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDdwN3_m35iby1EBxOpB81Zc_PhQCCBDL4y7y-TZCq7y-bdnHS5UeabwRvDJQC4101ECAMoH6utokS2GS2IPDWLp8PCZlGdVxmaeZRBZM42vLD4v-JWDVoaEy7URbszVfDgqqo-i8NVnrjticS3pR3CAs4a3GcD4BnXlyt3mqrY0qmMljjIMinYfZJXBPoQprbkVo63lRXLKikkNeQv-zaj5dImguCAB-1ZQNufdurrXLQikkjY8T55\"/>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center shadow-inner\">\n<span class=\"material-symbols-outlined text-on-surface-variant text-[18px]\">person_outline</span>\n</div>\n</div>\n<!-- Bot\303\263n Invitar -->\n<button class=\"py-1.5 px-3 rounded-full bg-primary/10 hover:bg-primary/20 text-primary font-label-tag text-label-tag flex items-center gap-1 active:scale-95 transition-all\" onclick=\"triggerShareToast()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">person_add</span>\n              + Invitar\n            </button>\n</div>\n</div>\n<!-- Footer Informativo -->\n<footer class=\"flex items-center justify-between text-body-sm text-on-surface-variant pt-1\">\n<div class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">pin_drop</span>\n<span class=\"truncate\">Sede Norte \342\200\242 Pista de Cristal</span>\n</div>\n<button class=\"text-primary hover:underline font-label-tag text-label-tag flex items-center gap-0.5\" type=\"button\">\n            Ver Detalles\n            <span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</button>\n</footer>\n</div>\n</article>\n</div>\n<!-- Drawer Modal: Subida de Comprobante Bancario -->\n<aside aria-labelledby=\"drawer-title\" aria-modal=\"true\" class=\"fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 flex flex-col justify-end\" id=\"payment-drawer\" role=\"dialog\">\n<!-- Backdrop oscuro -->\n<div class=\"absolute inset-0 bg-surface-dim/80 backdrop-blur-md\" onclick=\"closePaymentDrawer()\"></div>\n<!-- Contenido del Drawer -->\n<div class=\"relative w-full rounded-t-3xl bg-surface-container-high p-space-lg shadow-2xl flex flex-col gap-space-md max-h-[795px] overflow-y-auto transform translate-y-full transition-transform duration-300 ease-out\" id=\"drawer-panel\">\n<!-- Indicador de arrastre -->\n<div class=\"w-10 h-1 rounded-full bg-outline/40 self-center mb-1\"></div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-label-tag text-label-tag text-primary uppercase tracking-wider\">Pago de Cancha</span>\n<h2 class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface font-bold\" id=\"drawer-title\">Transferencia Bancaria</h2>\n</div>\n<button class=\"p-2 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface min-w-[36px] min-h-[36px] flex items-center justify-center\" onclick=\"closePaymentDrawer()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">close</span>\n</button>\n</div>\n<!-- Datos Bancarios del Club -->\n<div class=\"p-space-md rounded-xl bg-surface-container-lowest flex flex-col gap-space-xs\">\n<div class=\"flex justify-between items-center text-body-sm\">\n<span class=\"text-on-surface-variant\">Banco:</span>\n<span class=\"text-on-surface font-bold\">Santander R\303\255o</span>\n</div>\n<div class=\"flex justify-between items-center text-body-sm\">\n<span class=\"text-on-surface-variant\">Titular:</span>\n<span class=\"text-on-surface font-medium truncate ml-2\">Padel Assist Club S.A.</span>\n</div>\n<div class=\"flex justify-between items-center text-body-sm\">\n<span class=\"text-on-surface-variant\">Alias:</span>\n<div class=\"flex items-center gap-1.5\">\n<span class=\"text-primary font-label-numeric-md text-label-numeric-md\">PADEL.PRO.OFICIAL</span>\n<button class=\"text-on-surface-variant hover:text-primary\" onclick=\"triggerCopyAlias()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">content_copy</span>\n</button>\n</div>\n</div>\n<div class=\"flex justify-between items-center pt-2 mt-1\">\n<span class=\"text-body-md text-on-surface font-semibold\">Total a transferir:</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-primary font-bold\">$28.00</span>\n</div>\n</div>\n<!-- Zona de Carga de Comprobante -->\n<div class=\"p-space-lg rounded-xl bg-surface-container text-center flex flex-col items-center justify-center gap-space-xs cursor-pointer hover:bg-surface-bright/50 transition-colors\">\n<div class=\"w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-1\">\n<span class=\"material-symbols-outlined text-[28px]\">cloud_upload</span>\n</div>\n<span class=\"font-headline-md text-body-lg text-on-surface font-bold\">Adjuntar captura o PDF</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Formatos JPG, PNG o comprobante bancario (M\303\241x 5MB)</span>\n</div>\n<!-- Bot\303\263n de Confirmaci\303\263n -->\n<button class=\"w-full py-3 px-space-md rounded-xl bg-primary text-on-primary font-headline-md text-body-lg font-bold flex items-center justify-center gap-space-sm active:scale-95 transition-transform shadow-lg shadow-primary/20\" onclick=\"confirmPaymentUpload()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[20px]\">check</span>\n        Enviar Comprobante\n      </button>\n</div>\n</aside>\n<!-- Modal Di\303\241logo: Cancelar Reserva -->\n<dialog class=\"fixed inset-0 z-50 m-0 p-0 w-full h-full bg-transparent max-w-none max-h-none backdrop:bg-surface-dim/80 backdrop:backdrop-blur-sm hidden items-center justify-center px-space-md\" id=\"cancel-modal\">\n<div class=\"w-full max-w-sm p-space-lg rounded-2xl bg-surface-container-high shadow-2xl flex flex-col gap-space-md\">\n<div class=\"w-12 h-12 rounded-full bg-error-container/30 text-error flex items-center justify-center self-center\">\n<span class=\"material-symbols-outlined text-[28px]\">warning</span>\n</div>\n<div class=\"text-center flex flex-col gap-1\">\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold\">\302\277Liberar este turno?</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n          Est\303\241s a tiempo de cancelar sin penalizaci\303\263n. La pista quedar\303\241 disponible para otros jugadores de la comunidad.\n        </p>\n</div>\n<div class=\"flex flex-col gap-space-xs mt-1\">\n<button class=\"w-full py-2.5 rounded-xl bg-error text-on-error font-headline-md text-body-md font-bold active:scale-95 transition-transform\" onclick=\"closeCancelModal()\" type=\"button\">\n          S\303\255, Cancelar Turno\n        </button>\n<button class=\"w-full py-2.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-bright font-headline-md text-body-md transition-colors\" onclick=\"closeCancelModal()\" type=\"button\">\n          Mantener Reserva\n        </button>\n</div>\n</div>\n</dialog>\n</div>\n<script>\n  let toastTimer = null;\n\n  function triggerShareToast() {\n    const toast = document.getElementById(\'toast-notification\');\n    if (!toast) return;\n\n    if (navigator.clipboard) {\n      navigator.clipboard.writeText(\'https://padelassist.app/match/pc-7921-inv\').catch(() => {});\n    }\n\n    toast.classList.remove(\'opacity-0\', \'-translate-y-8\', \'pointer-events-none\');\n    toast.classList.add(\'opacity-100\', \'translate-y-0\');\n\n    if (toastTimer) clearTimeout(toastTimer);\n    toastTimer = setTimeout(() => {\n      hideToast();\n    }, 3500);\n  }\n\n  function hideToast() {\n    const toast = document.getElementById(\'toast-notification\');\n    if (!toast) return;\n    toast.classList.add(\'opacity-0\', \'-translate-y-8\', \'pointer-events-none\');\n    toast.classList.remove(\'opacity-100\', \'translate-y-0\');\n  }\n\n  function triggerCopyAlias() {\n    triggerShareToast();\n  }\n\n  function openPaymentDrawer() {\n    const drawer = document.getElementById(\'payment-drawer\');\n    const panel = document.getElementById(\'drawer-panel\');\n    if (!drawer || !panel) return;\n\n    drawer.classList.remove(\'pointer-events-none\', \'opacity-0\');\n    drawer.classList.add(\'opacity-100\');\n    panel.classList.remove(\'translate-y-full\');\n    panel.classList.add(\'translate-y-0\');\n  }\n\n  function closePaymentDrawer() {\n    const drawer = document.getElementById(\'payment-drawer\');\n    const panel = document.getElementById(\'drawer-panel\');\n    if (!drawer || !panel) return;\n\n    drawer.classList.add(\'opacity-0\');\n    panel.classList.remove(\'translate-y-0\');\n    panel.classList.add(\'translate-y-full\');\n\n    setTimeout(() => {\n      drawer.classList.add(\'pointer-events-none\');\n    }, 300);\n  }\n\n  function confirmPaymentUpload() {\n    closePaymentDrawer();\n    setTimeout(() => {\n      triggerShareToast();\n    }, 350);\n  }\n\n  function openCancelModal() {\n    const modal = document.getElementById(\'cancel-modal\');\n    if (!modal) return;\n    modal.classList.remove(\'hidden\');\n    modal.classList.add(\'flex\');\n    modal.showModal?.();\n  }\n\n  function closeCancelModal() {\n    const modal = document.getElementById(\'cancel-modal\');\n    if (!modal) return;\n    modal.close?.();\n    modal.classList.remove(\'flex\');\n    modal.classList.add(\'hidden\');\n  }\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface-container-lowest/85 backdrop-blur-2xl shadow-[0_-8px_24px_rgba(0,0,0,0.6)]\" data-active-classes=\"text-primary font-semibold [&amp;_.active-pill]:scale-100 [&amp;_.active-pill]:opacity-100 [&amp;_.nav-icon]:translate-y-[-2px]\"><div class=\"grid grid-cols-4 items-center h-20 px-space-xs\"><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"canchas\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">sports_tennis</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Canchas</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"reservar\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">edit_calendar</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Reservar</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a aria-current=\"page\