  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * Types and interfaces for Padel Assist Pro\n * Matches the PostgreSQL schema and frontend components\n */\n\nexport type UserRole = \'customer\' | \'club_admin\' | \'superadmin\';\n\nexport interface UserProfile {\n  id: string;\n  full_name: string;\n  phone: string;\n  avatar_url?: string;\n  role: UserRole;\n  category?: string;\n  initials?: string;\n  created_at?: string;\n}\n\nexport type CourtFilterType = \'all\' | \'panoramica\' | \'techada\' | \'exterior\';\n\nexport interface CourtSpec {\n  icon: string;\n  label: string;\n  colorClass?: string;\n}\n\nexport interface QuickSlot {\n  time: string;\n  available: boolean;\n}\n\nexport interface Court {\n  id: string;\n  name: string;\n  type: string;\n  category: \'panoramica\' | \'techada\' | \'exterior\';\n  court_number_label: string;\n  is_active: boolean;\n  hourly_rate: number;\n  rate_for_90m: number;\n  photos: string[];\n  description: string;\n  specs: CourtSpec[];\n  quick_slots: QuickSlot[];\n  banner_badge: string;\n  banner_color: string;\n  instant_badge: string;\n  is_favorite?: boolean;\n}\n\nexport interface Amenity {\n  id: string;\n  title: string;\n  category: \'alquiler\' | \'tienda\' | \'servicio_gratis\';\n  price: number;\n  is_available: boolean;\n  image_url?: string;\n  subtitle?: string;\n}\n\nexport type BookingStatus = \'pending_payment\' | \'confirmed\' | \'cancelled\' | \'completed\';\n\nexport interface PlayerSlot {\n  name: string;\n  avatar?: string;\n  initials?: string;\n  is_captain?: boolean;\n}\n\nexport interface Booking {\n  id: string;\n  court_id: string;\n  court_name: string;\n  court_type: string;\n  court_image: string;\n  court_badge?: string;\n  user_id: string;\n  user_name: string;\n  guest_name?: string;\n  guest_phone?: string;\n  start_time: string;\n  end_time: string;\n  date_label: string;\n  date_full: string;\n  duration_min: number;\n  court_price: number;\n  lighting_price: number;\n  total_price: number;\n  status: BookingStatus;\n  payment_proof_url?: string;\n  payment_method?: string;\n  notes?: string;\n  players: PlayerSlot[];\n  max_players: number;\n  location_label: string;\n  countdown_text?: string;\n  created_at: string;\n}\n\nexport interface TimeSlot {\n  id: string;\n  time_range: string;\n  start_hour: string;\n  period: \'morning\' | \'afternoon\' | \'night\';\n  price: number;\n  label?: string;\n  status: \'available\' | \'booked\' | \'in_game\' | \'selected\' | \'blocked\';\n  is_last?: boolean;\n}\n\nexport type NavView = \'canchas\' | \'reservar\' | \'mis-partidos\' | \'club-info\';\n\nexport interface ToastMessage {\n  id: string;\n  title: string;\n  description: string;\n  type?: \'success\' | \'info\' | \'error\';\n}\n"
        path {
          absolute_uri: "file:///src/types.ts"
        }
        overwrite: true
      }
    }
