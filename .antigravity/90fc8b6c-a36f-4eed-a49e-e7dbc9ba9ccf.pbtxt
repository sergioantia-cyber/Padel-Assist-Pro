              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- Los clientes solo ven el horario bloqueado en la vista p\303\272blica, pero NO los datos de qui\303\251n reserv\303\263"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CREATE POLICY \"Customers view own booking details\" "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "ON bookings FOR SELECT "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "USING ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    auth.uid() = user_id "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
