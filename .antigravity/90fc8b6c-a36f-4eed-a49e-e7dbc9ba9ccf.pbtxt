ass=\"material-symbols-outlined text-primary text-[18px]\">calendar_month</span>\n<span class=\"font-headline-md text-headline-md text-on-surface\">Octubre 2024</span>\n</div>\n<span class=\"font-label-tag text-label-tag text-primary-fixed-dim bg-surface-container-high px-2 py-0.5 rounded-full flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary animate-pulse\"></span>\n        Semana 42\n      </span>\n</div>\n<!-- Date Strip Slider -->\n<div class=\"flex items-center gap-space-xs overflow-x-auto pb-1 -mx-margin px-margin scrollbar-none\" id=\"date-scroller\">\n<!-- Day 1 - HOY (Selected Active) -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-primary-container text-on-primary-container shadow-[0_0_20px_rgba(16,185,129,0.35)] active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-90\">Hoy</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg font-bold\">14</span>\n<span class=\"font-body-sm text-body-sm font-semibold opacity-90\">LUN</span>\n</button>\n<!-- Day 2 -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-surface-container-high text-on-surface-variant hover:text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-75\">Mar</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-on-surface\">15</span>\n<span class=\"font-body-sm text-body-sm text-outline\">Libre</span>\n</button>\n<!-- Day 3 -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-surface-container-high text-on-surface-variant hover:text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-75\">Mi\303\251</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-on-surface\">16</span>\n<span class=\"font-body-sm text-body-sm text-outline\">Libre</span>\n</button>\n<!-- Day 4 -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-surface-container-high text-on-surface-variant hover:text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-75\">Jue</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-on-surface\">17</span>\n<span class=\"font-body-sm text-body-sm text-outline\">Pocos</span>\n</button>\n<!-- Day 5 -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-surface-container-high text-on-surface-variant hover:text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-75\">Vie</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-on-surface\">18</span>\n<span class=\"font-body-sm text-body-sm text-primary\">Alta Dem.</span>\n</button>\n<!-- Day 6 -->\n<button class=\"group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl bg-surface-container-high text-on-surface-variant hover:text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" type=\"button\">\n<span class=\"font-label-tag text-label-tag tracking-wider uppercase opacity-75\">S\303\241b</span>\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-on-surface\">19</span>\n<span class=\"font-body-sm text-body-sm text-error\">Lleno</span>\n</button>\n</div>\n</section>\n<!-- Court Selector Segmented Pill -->\n<section class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-label-tag text-label-tag uppercase tracking-wider text-on-surface-variant\">Pista deportiva</span>\n<span class=\"font-body-sm text-body-sm text-secondary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">sports_tennis</span>\n        Cristal WPT 12mm\n      </span>\n</div>\n<div class=\"relative bg-surface-container-lowest p-1 rounded-xl flex items-center shadow-inner\">\n<button class=\"flex-1 py-2 text-center rounded-lg bg-surface-container text-on-surface font-headline-md text-body-sm shadow-md transition-all flex items-center justify-center gap-1.5\" id=\"pista-panoramica\" type=\"button\">\n<span class=\"w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_#4edea3]\"></span>\n        P1 Panor\303\241mica\n      </button>\n<button class=\"flex-1 py-2 text-center rounded-lg text-on-surface-variant hover:text-on-surface font-body-md text-body-sm transition-all flex items-center justify-center gap-1.5\" id=\"pista-techada\" type=\"button\">\n        P2 Techada\n      </button>\n<button class=\"flex-1 py-2 text-center rounded-lg text-on-surface-variant hover:text-on-surface font-body-md text-body-sm transition-all flex items-center justify-center gap-1.5\" id=\"pista-exterior\" type=\"button\">\n        P3 Exterior\n      </button>\n</div>\n</section>\n<!-- Duration Switcher -->\n<section class=\"flex flex-col gap-space-xs\">\n<span class=\"font-label-tag text-label-tag uppercase tracking-wider text-on-surface-variant\">Duraci\303\263n de la sesi\303\263n</span>\n<div class=\"grid grid-cols-3 gap-2\">\n<button class=\"py-2 px-3 rounded-lg bg-surface-container-high text-on-surface-variant hover:text-on-surface text-center font-label-numeric-md text-label-numeric-md active:scale-95 transition-all\" type=\"button\">\n        60 min\n      </button>\n<button class=\"relative py-2 px-3 rounded-lg bg-surface-container-highest text-on-surface text-center font-label-numeric-md text-label-numeric-md active:scale-95 shadow-[inset_0_0_0_1px_rgba(78,222,163,0.4)] flex flex-col items-center justify-center\" type=\"button\">\n<span class=\"text-primary font-bold\">90 min</span>\n<span class=\"font-label-tag text-[9px] tracking-tight text-primary-fixed uppercase leading-none mt-0.5\">Recomendado</span>\n</button>\n<button class=\"py-2 px-3 rounded-lg bg-surface-container-high text-on-surface-variant hover:text-on-surface text-center font-label-numeric-md text-label-numeric-md active:scale-95 transition-all\" type=\"button\">\n        120 min\n      </button>\n</div>\n</section>\n<!-- Time Slots Grid -->\n<section class=\"flex flex-col gap-space-md pb-4\">\n<div class=\"flex items-center justify-between\">\n<span class=\"font-headline-md text-headline-md text-on-surface\">Horarios Disponibles</span>\n<div class=\"flex items-center gap-space-sm font-label-tag text-label-tag text-on-surface-variant\">\n<span class=\"flex items-center gap-1\"><span class=\"w-2 h-2 rounded-full bg-primary\"></span>Libre</span>\n<span class=\"flex items-center gap-1\"><span class=\"w-2 h-2 rounded-full bg-surface-bright\"></span>Ocupado</span>\n</div>\n</div>\n<!-- Group 1: MA\303\221ANA -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center gap-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\">wb_sunny</span>\n<span class=\"font-label-tag text-label-tag uppercase tracking-wider\">Ma\303\261ana</span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-xs\">\n<!-- Available Slot -->\n<button class=\"relative p-3 rounded-xl bg-surface-container-high text-left flex flex-col justify-between hover:bg-surface-bright active:scale-95 transition-all min-h-[72px]\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface\">08:00 - 09:30</span>\n<span class=\"w-2 h-2 rounded-full bg-primary shadow-[0_0_6px_#4edea3]\"></span>\n</div>\n<div class=\"flex items-center justify-between w-full mt-1\">\n<span class=\"font-label-tag text-label-tag text-primary-fixed font-bold\">$22.00</span>\n<span class=\"font-body-sm text-body-sm text-outline\">Fresca</span>\n</div>\n</button>\n<!-- Booked Slot -->\n<div class=\"relative p-3 rounded-xl bg-surface-container-lowest opacity-40 flex flex-col justify-between min-h-[72px] cursor-not-allowed\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md line-through text-outline\">09:30 - 11:00</span>\n<span class=\"material-symbols-outlined text-outline text-[16px]\">lock</span>\n</div>\n<span class=\"font-label-tag text-label-tag text-outline tracking-wider uppercase mt-1\">Reservado</span>\n</div>\n</div>\n</div>\n<!-- Group 2: TARDE -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center gap-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary\">flare</span>\n<span class=\"font-label-tag text-label-tag uppercase tracking-wider\">Tarde Prime</span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-xs\">\n<!-- Available Slot -->\n<button class=\"relative p-3 rounded-xl bg-surface-container-high text-left flex flex-col justify-between hover:bg-surface-bright active:scale-95 transition-all min-h-[72px]\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface\">16:30 - 18:00</span>\n<span class=\"w-2 h-2 rounded-full bg-primary shadow-[0_0_6px_#4edea3]\"></span>\n</div>\n<div class=\"flex items-center justify-between w-full mt-1\">\n<span class=\"font-label-tag text-label-tag text-on-surface font-semibold\">$24.00</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Sin sol</span>\n</div>\n</button>\n<!-- SELECTED SLOT (Tu Selecci\303\263n) -->\n<button class=\"relative p-3 rounded-xl bg-surface-container-highest shadow-[0_0_18px_rgba(16,185,129,0.3)] text-left flex flex-col justify-between active:scale-95 transition-all min-h-[72px] ring-2 ring-primary\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md text-primary font-bold\">18:00 - 19:30</span>\n<div class=\"w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] font-bold\">check</span>\n</div>\n</div>\n<div class=\"flex items-center justify-between w-full mt-1\">\n<span class=\"font-label-tag text-label-tag text-primary font-bold\">$24.00</span>\n<span class=\"font-label-tag text-label-tag px-1.5 py-0.5 rounded-full bg-primary text-on-primary font-bold uppercase tracking-wider\">Tu Turno</span>\n</div>\n</button>\n</div>\n</div>\n<!-- Group 3: NOCHE -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center gap-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px] text-tertiary-fixed-dim\">bedtime</span>\n<span class=\"font-label-tag text-label-tag uppercase tracking-wider\">Noche Focos LED</span>\n</div>\n<div class=\"grid grid-cols-2 gap-space-xs\">\n<!-- Booked Slot with visual pulse -->\n<div class=\"relative p-3 rounded-xl bg-surface-container-lowest opacity-40 flex flex-col justify-between min-h-[72px] cursor-not-allowed\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md line-through text-outline\">19:30 - 21:00</span>\n<span class=\"material-symbols-outlined text-outline text-[16px]\">lock</span>\n</div>\n<div class=\"flex items-center gap-1 mt-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-error opacity-75\"></span>\n<span class=\"font-label-tag text-label-tag text-outline tracking-wider uppercase\">En juego</span>\n</div>\n</div>\n<!-- Available - \303\232ltimo Turno -->\n<button class=\"relative p-3 rounded-xl bg-surface-container-high text-left flex flex-col justify-between hover:bg-surface-bright active:scale-95 transition-all min-h-[72px]\" type=\"button\">\n<div class=\"flex items-center justify-between w-full\">\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface\">21:00 - 22:30</span>\n<span class=\"w-2 h-2 rounded-full bg-primary shadow-[0_0_6px_#4edea3]\"></span>\n</div>\n<div class=\"flex items-center justify-between w-full mt-1\">\n<span class=\"font-label-tag text-label-tag text-primary-fixed font-bold\">$26.00</span>\n<span class=\"font-label-tag text-label-tag px-1 rounded bg-secondary-container text-on-secondary-container\">\303\232ltimo</span>\n</div>\n</button>\n</div>\n</div>\n</section>\n<!-- Pinned Bottom Sheet Drawer (Visible Resumen de Compra) -->\n<section class=\"mt-2 bg-surface-container-high rounded-2xl p-space-md shadow-2xl flex flex-col gap-space-md relative overflow-hidden backdrop-blur-xl\">\n<!-- Ambient subtle top glow inside sheet -->\n<div class=\"absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-primary to-transparent opacity-80\"></div>\n<!-- Drag Handle -->\n<div class=\"w-full flex items-center justify-center pt-1\">\n<div class=\"w-10 h-1 rounded-full bg-outline-variant\"></div>\n</div>\n<!-- Sheet Header -->\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">verified</span>\n<h3 class=\"font-headline-md text-headline-md text-on-surface\">Confirmar Reserva</h3>\n</div>\n<span class=\"font-label-tag text-label-tag px-2 py-0.5 rounded-full bg-primary-container text-on-primary-container font-semibold uppercase\">Paso 1 de 2</span>\n</div>\n<!-- Row 1: Court with Miniature Photo Placeholder -->\n<div class=\"flex items-center justify-between bg-surface-container p-space-sm rounded-xl\">\n<div class=\"flex items-center gap-space-sm\">\n<img class=\"w-12 h-12 rounded-lg object-cover shadow-sm shrink-0\" data-alt=\"High tech indoor padel court with blue turf, clear glass walls and professional LED floodlights in an athletic tournament club setting with dark moody cyber aesthetics.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBaaoPTnNrICAR2EsAia1SgbsYRco0eRBV8F0PUzkhM26m1sN7qAI3SVW7vF0B-sCF9fq_M0rfBwN_BEJtfZuZNxAW4EGCwm5gQaziX9_FqMesrqBW8j0777RD-ouBmYNQoGMGeiTUMXh2MBWd1LzhXqBS02fJYoteJPAmEpt4vhjpwqLBy7WOuW5Mnnn0vtcIWe_TXsMOm_4IGIjFK8PlXNsyKyigtH39_EfFYa2JAIyctWb41BlPL\"/>\n<div class=\"flex flex-col min-w-0\">\n<span class=\"font-body-lg text-body-lg font-bold text-on-surface truncate\">Pista 1 Panor\303\241mica Pro</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[13px] text-primary\">check_circle</span>\n            C\303\251sped Mondo Supercourt XN\n          </span>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-outline\">tune</span>\n</div>\n<!-- Row 2: Date & Time Metadata Badge -->\n<div class=\"flex items-center justify-between bg-surface-container-lowest p- space-sm px-3 py-2.5 rounded-xl\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-secondary text-[20px]\">schedule</span>\n<div class=\"flex flex-col\">\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface\">Hoy, 18:00 - 19:30</span>\n<span class=\"font-body-sm text-body-sm text-outline\">Lunes 14 de Octubre</span>\n</div>\n</div>\n<div class=\"text-right\">\n<span class=\"font-label-tag text-label-tag px-2 py-1 rounded-lg bg-surface-container-highest text-primary font-bold\">90 Minutos</span>\n</div>\n</div>\n<!-- Row 3: Live Cost Breakdown -->\n<div class=\"flex flex-col gap-1.5 px-1 py-1\">\n<div class=\"flex items-center justify-between font-body-sm text-body-sm text-on-surface-variant\">\n<span>Alquiler Pista (90 min)</span>\n<span class=\"font-label-numeric-sm text-label-numeric-sm text-on-surface\">$24.00</span>\n</div>\n<div class=\"flex items-center justify-between font-body-sm text-body-sm text-on-surface-variant\">\n<span class=\"flex items-center gap-1\">\n          Luz LED Pro Torneo\n          <span class=\"material-symbols-outlined text-[14px] text-tertiary\">bolt</span>\n</span>\n<span class=\"font-label-numeric-sm text-label-numeric-sm text-on-surface\">$4.00</span>\n</div>\n<div class=\"flex items-center justify-between pt-2 mt-1 bg-surface-container-highest/30 px-2 py-1.5 rounded-lg\">\n<div class=\"flex flex-col\">\n<span class=\"font-headline-md text-body-lg font-bold text-on-surface\">Total a Pagar</span>\n<span class=\"font-body-sm text-body-sm text-primary\">Dividir pago disponible al instante</span>\n</div>\n<span class=\"font-label-numeric-lg text-headline-lg-mobile text-primary font-bold tracking-tight\">$28.00</span>\n</div>\n</div>\n<!-- Team Note Input Field -->\n<div class=\"flex flex-col gap-1\">\n<label class=\"font-label-tag text-label-tag uppercase tracking-wider text-on-surface-variant flex items-center justify-between\" for=\"team-note\">\n<span>Nombre de equipo o nota al club</span>\n<span class=\"text-outline lowercase font-normal\">(opcional)</span>\n</label>\n<div class=\"relative flex items-center\">\n<span class=\"material-symbols-outlined absolute left-3 text-outline text-[18px]\">group</span>\n<input class=\"w-full bg-surface-container-lowest text-on-surface font-body-md text-body-md rounded-xl pl-9 pr-3 py-2.5 focus:outline-none focus:ring-1 focus:ring-primary placeholder:text-outline-variant\" id=\"team-note\" placeholder=\"Ej. Pareja Garc\303\255a / Los Gal\303\241cticos\" type=\"text\"/>\n</div>\n</div>\n<!-- Primary CTA Instant Checkout Button -->\n<button class=\"w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-primary-container via-primary to-secondary text-on-primary-container font-headline-md text-body-lg font-extrabold flex items-center justify-center gap-2 shadow-[0_8px_24px_rgba(16,185,129,0.35)] active:scale-95 transition-all\" id=\"confirm-booking-btn\" type=\"button\">\n<span class=\"material-symbols-outlined animate-spin text-[20px] hidden\" id=\"checkout-spinner\">sync</span>\n<span id=\"btn-text\">Continuar a Confirmaci\303\263n</span>\n<span class=\"material-symbols-outlined text-[20px]\" id=\"btn-arrow\">arrow_forward</span>\n</button>\n</section>\n</div>\n<script>\n  // Simple micro-interaction for the checkout trigger\n  const confirmBtn = document.getElementById(\'confirm-booking-btn\');\n  const spinner = document.getElementById(\'checkout-spinner\');\n  const btnText = document.getElementById(\'btn-text\');\n  const btnArrow = document.getElementById(\'btn-arrow\');\n\n  if (confirmBtn) {\n    confirmBtn.addEventListener(\'click\', () => {\n      spinner.classList.remove(\'hidden\');\n      btnArrow.classList.add(\'hidden\');\n      btnText.textContent = \'Bloqueando Turno...\';\n      confirmBtn.classList.add(\'opacity-90\');\n      \n      setTimeout(() => {\n        spinner.classList.add(\'hidden\');\n        btnArrow.classList.remove(\'hidden\');\n        btnArrow.textContent = \'done_all\';\n        btnText.textContent = \'\302\241Pista Reservada!\';\n        confirmBtn.classList.remove(\'from-primary-container\');\n        confirmBtn.classList.add(\'bg-primary\');\n      }, 1200);\n    });\n  }\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface-container-lowest/85 backdrop-blur-2xl shadow-[0_-8px_24px_rgba(0,0,0,0.6)]\" data-active-classes=\"text-primary font-semibold [&amp;_.active-pill]:scale-100 [&amp;_.active-pill]:opacity-100 [&amp;_.nav-icon]:translate-y-[-2px]\"><div class=\"grid grid-cols-4 items-center h-20 px-space-xs\"><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"canchas\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">sports_tennis</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Canchas</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a aria-current=\"page\" class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] transition-all duration-300 active:scale-95 text-primary font-semibold [&amp;_.active-pill]:scale-100 [&amp;_.active-pill]:opacity-100 [&amp;_.nav-icon]:translate-y-[-2px]\" data-path=\"reservar\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">edit_calendar</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Reservar</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"mis-partidos\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">confirmation_number</span><span class=\"absolute -top-1 -right-1 flex h-2.5 w-2.5\"><span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span><span class=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-primary\"></span></span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Partidos</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"club-info\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">domain</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Club</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a></div></nav></body></html>"
