        instruction: "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\" width=\"512\" height=\"512\">\n  <defs>\n    <radialGradient id=\"padelGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n      <stop offset=\"0%\" stop-color=\"#4edea3\" stop-opacity=\"0.3\"/>\n      <stop offset=\"100%\" stop-color=\"#09090b\" stop-opacity=\"0\"/>\n    </radialGradient>\n    <linearGradient id=\"racketGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#6ffbbe\"/>\n      <stop offset=\"50%\" stop-color=\"#10b981\"/>\n      <stop offset=\"100%\" stop-color=\"#005236\"/>\n    </linearGradient>\n    <linearGradient id=\"ballGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#fef08a\"/>\n      <stop offset=\"100%\" stop-color=\"#84cc16\"/>\n    </linearGradient>\n  </defs>\n\n  <!-- Background -->\n  <rect width=\"512\" height=\"512\" rx=\"110\" fill=\"#09090b\"/>\n  <circle cx=\"256\" cy=\"256\" r=\"230\" fill=\"url(#padelGlow)\"/>\n\n  <!-- Outer Neon Ring -->\n  <circle cx=\"256\" cy=\"256\" r=\"220\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"4\" stroke-dasharray=\"8 6\" opacity=\"0.6\"/>\n  <circle cx=\"256\" cy=\"256\" r=\"200\" fill=\"#181b25\" stroke=\"#31353f\" stroke-width=\"3\"/>\n\n  <!-- Padel Racket Head -->\n  <ellipse cx=\"256\" cy=\"210\" rx=\"100\" ry=\"115\" fill=\"url(#racketGrad)\" stroke=\"#6ffbbe\" stroke-width=\"4\"/>\n  \n  <!-- Racket Perforations (Holes) -->\n  <g fill=\"#0f131c\" opacity=\"0.85\">\n    <circle cx=\"226\" cy=\"180\" r=\"7\"/>\n    <circle cx=\"256\" cy=\"180\" r=\"7\"/>\n    <circle cx=\"286\" cy=\"180\" r=\"7\"/>\n    <circle cx=\"210\" cy=\"210\" r=\"7\"/>\n    <circle cx=\"240\" cy=\"210\" r=\"7\"/>\n    <circle cx=\"272\" cy=\"210\" r=\"7\"/>\n    <circle cx=\"302\" cy=\"210\" r=\"7\"/>\n    <circle cx=\"226\" cy=\"240\" r=\"7\"/>\n    <circle cx=\"256\" cy=\"240\" r=\"7\"/>\n    <circle cx=\"286\" cy=\"240\" r=\"7\"/>\n  </g>\n\n  <!-- Throat