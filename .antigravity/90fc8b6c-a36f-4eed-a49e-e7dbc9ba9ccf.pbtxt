        instruction: "import React from \'react\';\n\nexport interface CalendarDay {\n  dayNumber: number;\n  dayName: string;\n  isToday: boolean;\n  statusLabel: string;\n  statusType: \'available\' | \'low\' | \'high_demand\' | \'full\';\n  dateStr: string;\n  fullDateText: string;\n}\n\ninterface CalendarStripProps {\n  selectedDate: string;\n  onSelectDate: (day: CalendarDay) => void;\n}\n\nexport const CalendarStrip: React.FC<CalendarStripProps> = ({\n  selectedDate,\n  onSelectDate,\n}) => {\n  const days: CalendarDay[] = [\n    {\n      dayNumber: 14,\n      dayName: \'LUN\',\n      isToday: true,\n      statusLabel: \'Hoy\',\n      statusType: \'available\',\n      dateStr: \'2024-10-14\',\n      fullDateText: \'Lunes 14 de Octubre\',\n    },\n    {\n      dayNumber: 15,\n      dayName: \'MAR\',\n      isToday: false,\n      statusLabel: \'Libre\',\n      statusType: \'available\',\n      dateStr: \'2024-10-15\',\n      fullDateText: \'Martes 15 de Octubre\',\n    },\n    {\n      dayNumber: 16,\n      dayName: \'MI\303\211\',\n      isToday: false,\n      statusLabel: \'Libre\',\n      statusType: \'available\',\n      dateStr: \'2024-10-16\',\n      fullDateText: \'Mi\303\251rcoles 16 de Octubre\',\n    },\n    {\n      dayNumber: 17,\n      dayName: \'JUE\',\n      isToday: false,\n      statusLabel: \'Pocos\',\n      statusType: \'low\',\n      dateStr: \'2024-10-17\',\n      fullDateText: \'Jueves 17 de Octubre\',\n    },\n    {\n      dayNumber: 18,\n      dayName: \'VIE\',\n      isToday: false,\n      statusLabel: \'Alta Dem.\',\n      statusType: \'high_demand\',\n      dateStr: \'2024-10-18\',\n      fullDateText: \'Viernes 18 de Octubre\',\n    },\n    {\n      dayNumber: 19,\n      dayName: \'S\303\201B\',\n      isToday: false,\n      statusLabel: \'Lleno\',\n      statusType: \'full\',\n      dateStr: \'2024-10-19\',\n      fullDateText: \'S\303\241bado 19 de Octubre\',\n    },\n    {\n      dayNumber: 20,\n      dayName: \'DOM\',\n      isToday: false,\n      statusLabel: \'Libre\',\n      statusType: \'available\',\n      dateStr: \'2024-10-20\',\n      fullDateText: \'Domingo 20 de Octubre\',\n    },\n  ];\n\n  return (\n    <section className=\"flex flex-col gap-2\">\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"material-symbols-outlined text-[#4edea3] text-[20px]\">\n            calendar_month\n          </span>\n          <span className=\"text-[18px] font-bold text-[#dfe2ef]\">\n            Octubre 2024\n          </span>\n        </div>\n        <span className=\"text-[11px] font-bold text-[#4edea3] bg-[#262a34] px-2.5 py-1 rounded-full flex items-center gap-1.5 border border-[#31353f]\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-[#4edea3] animate-pulse\"></span>\n          Semana 42\n        </span>\n      </div>\n\n      {/* Date Strip Slider */}\n      <div\n        className=\"flex items-center gap-2 overflow-x-auto pb-1 -mx-4 px-4 scrollbar-none\"\n        id=\"date-scroller\"\n      >\n        {days.map((day) => {\n          const isSelected = selectedDate === day.dateStr;\n          return (\n            <button\n              key={day.dateStr}\n              onClick={() => onSelectDate(day)}\n              className={`group flex flex-col items-center justify-center min-w-[64px] py-2.5 rounded-xl transition-all active:scale-95 cursor-pointer ${\n                isSelected\n                  ? \'bg-[#10b981] text-[#00422b] shadow-[0_0_20px_rgba(16,185,129,0.35)]\'\n                  : \'bg-[#262a34] text-[#bbcabf] hover:text-[#dfe2ef] hover:bg-[#353943] border border-[#31353f]/40\'\n              }`}\n              type=\"button\"\n            >\n              <span\n                className={`text-[11px] font-bold tracking-wider uppercase ${\n                  isSelected ? \'opacity-90\' : \'opacity-75\'\n                }`}\n              >\n                {day.isToday ? \'Hoy\' : day.dayName}\n              </span>\n              <span\n                className={`font-mono text-[22px] font-bold ${\n                  isSelected ? \'text-[#00422b]\' : \'text-[#dfe2ef]\'\n                }`}\n              >\n                {day.dayNumber}\n              </span>\n              <span\n                className={`text-[12px] font-semibold ${\n                  isSelected\n                    ? \'opacity-90\'\n                    : day.statusType === \'full\'\n                    ? \'text-[#ffb4ab]\'\n                    : day.statusType === \'high_demand\'\n                    ? \'text-[#4edea3]\'\n                    : \'text-[#86948a]\'\n                }`}\n              >\n                {day.isToday ? \'LUN\' : day.statusLabel}\n              </span>\n            </button>\n          );\n        })}\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/CalendarStrip.tsx"
        }
        overwrite: true
      }
    }
