            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name TEXT NOT NULL, -- ej: \"Cancha 1 (Panor\303\241mica)\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type TEXT NOT NULL, -- \"Cristal Techada\", \"Malla Descubierta\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    is_active BOOLEAN DEFAULT TRUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hourly_rate NUMERIC(10, 2) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    photos TEXT[] DEFAULT \'{}\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    description TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 4. CAT\303\201LOGO DE SERVICIOS ADICIONALES (Cafeter\303\255a, Alquiler de palas, Tienda)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE amenities_catalog ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title TEXT NOT NULL, -- ej: \"Pala Bullpadel Pro\", \"Gatorade 500ml\", \"Duchas y Vestuarios\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category TEXT NOT NULL, -- \'alquiler\', \'tienda\', \'servicio_gratis\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    price NUMERIC(10, 2) DEFAULT 0.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    is_available BOOLEAN DEFAULT TRUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    image_url TEXT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 5. RESERVAS DE CANCHAS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE bookings ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    court_id UUID REFERENCES courts(id) ON DELETE RESTRICT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    user_id UUID REFERENCES profiles(id) ON DELETE SET NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    guest_name TEXT, -- Por si el club la anota manualmente para alguien sin app"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    guest_phone TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    start_time TIMESTAMPTZ NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    end_time TIMESTAMPTZ NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    total_price NUMERIC(10, 2) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status booking_status DEFAULT \'pending_payment\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    payment_proof_url TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    notes TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    -- Evita solapamiento de horarios exactos en la misma cancha"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    CONSTRAINT check_booking_duration CHECK (end_time > start_time)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- \303\215ndice para acelerar la consulta de disponibilidad horaria"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX idx_bookings_court_time ON bookings (court_id, start_time, end_time);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ===================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ROW LEVEL SECURITY (RLS) POLICIES"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ===================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Habilitar RLS en tablas cr\303\255ticas"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE bookings ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE courts ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE amenities_catalog ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- REGLAS PROFILES:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Cada usuario solo edita y lee su perfil; el administrador del club ve los perfiles de sus clientes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Users can view own profile\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON profiles FOR SELECT USING (auth.uid() = id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Users can update own profile\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON profiles FOR UPDATE USING (auth.uid() = id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- REGLAS COURTS & CATALOG:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Cualquiera (incluso sin login) puede ver canchas y cat\303\241logo para incentivar la visita"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Public read courts\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON courts FOR SELECT USING (is_active = TRUE);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Public read amenities\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON amenities_catalog FOR SELECT USING (is_available = TRUE);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- REGLAS BOOKINGS (Crucial para privacidad):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Los clientes solo ven el horario bloqueado en la vista p\303\272blica, pero NO los datos de qui\303\251n reserv\303\263"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Customers view own booking details\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON bookings FOR SELECT "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "USING ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    auth.uid() = user_id "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    OR "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    EXISTS (SELECT 1 FROM profiles WHERE profiles.id = auth.uid() AND profiles.role = \'club_admin\')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Inserci\303\263n de reserva: Usuarios autenticados"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY \"Authenticated users can create bookings\" "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON bookings FOR INSERT "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "WITH CHECK (auth.uid() = user_id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///src/db/schema.sql"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create database schema and RLS policies SQL definition"
    diff_stats {
      additions: 103
    }
  }
