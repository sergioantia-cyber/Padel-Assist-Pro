  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\n\nexport const ClubRulesAccordion: React.FC = () => {\n  const [openIndex, setOpenIndex] = useState<number | null>(null);\n\n  const rules = [\n    {\n      title: \'Uso obligatorio de suela espiga\',\n      icon: \'sports_score\',\n      content:\n        \'Para preservar la fibra sint\303\251tica y garantizar la tracci\303\263n segura en c\303\251sped monofilamento con arena, no se admiten zapatillas running o con suela de tacos agresivos. El club dispone de alquiler en pro-shop.\',\n    },\n    {\n      title: \'Cancelaciones gratuitas hasta 4h antes\',\n      icon: \'event_available\',\n      content:\n        \'Puedes reprogramar o anular tu reserva con reintegro \303\255ntegro a tu billetera de la app con un margen de al menos 4 horas previas al partido. Fuera de ese lapso se cargar\303\241 el dep\303\263sito de pista.\',\n    },\n    {\n      title: \'Alquiler de palas & Pro-Shop Oficial\',\n      icon: \'inventory_2\',\n      content:\n        \'En recepci\303\263n encontrar\303\241s palas de test Bullpadel y Head ($3.500 / turno), tubos de pelotas presurizadas nuevas, overgrips y servicio de encordado r\303\241pido.\',\n    },\n  ];\n\n  const toggleAccordion = (idx: number) => {\n    setOpenIndex(openIndex === idx ? null : idx);\n  };\n\n  return (\n    <div className=\"flex flex-col gap-2\">\n      <div className=\"flex items-center justify-between px-1\">\n        <h3 className=\"text-[18px] font-bold text-[#dfe2ef]\">\n          Normas y Servicios\n        </h3>\n        <span className=\"text-[11px] font-bold text-[#bbcabf] uppercase tracking-wider\">\n          Reglamento 2025\n        </span>\n      </div>\n\n      {rules.map((rule, idx) => {\n        const isOpen = openIndex === idx;\n        return (\n          <div\n            key={idx}\n            className=\"overflow-hidden rounded-xl bg-[#1c1f29]/70 backdrop-blur-sm border border-[#31353f]/60 transition-all duration-300\"\n          >\n            <button\n              onClick={() => toggleAccordion(idx)}\n              className=\"w-full p-3.5 flex items-center justify-between text-left gap-3 cursor-pointer\"\n              type=\"button\"\n            >\n              <div className=\"flex items-center gap-3 min-w-0\">\n                <span className=\"material-symbols-outlined text-[#4edea3] text-[22px] shrink-0\">\n                  {rule.icon}\n                </span>\n                <span className=\"text-[14px] text-[#dfe2ef] font-medium truncate\">\n                  {rule.title}\n                </span>\n              </div>\n              <span\n                className={`material-symbols-outlined text-[#bbcabf] transition-transform duration-200 shrink-0 ${\n                  isOpen ? \'rotate-180\' : \'rotate-0\'\n                }`}\n              >\n                expand_more\n              </span>\n            </button>\n            {isOpen && (\n              <div className=\"px-3.5 pb-3.5 text-[#bbcabf] text-[13px] leading-relaxed border-t border-[#31353f]/40 pt-2.5 animate-in fade-in duration-200\">\n                {rule.content}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ClubRulesAccordion.tsx"
        }
        overwrite: true
      }
    }
