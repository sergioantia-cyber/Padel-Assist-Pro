"-0.01em\", \"fontWeight\": \"700\" }], \"label-numeric-lg\": [\"22px\", { \"lineHeight\": \"26px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"label-numeric-md\": [\"16px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"600\" }], \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }], \"body-lg\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"500\" }], \"headline-xl\": [\"40px\", { \"lineHeight\": \"48px\", \"letterSpacing\": \"-0.03em\", \"fontWeight\": \"800\" }], \"headline-lg-mobile\": [\"24px\", { \"lineHeight\": \"30px\", \"letterSpacing\": \"-0.015em\", \"fontWeight\": \"700\" }], \"body-md\": [\"14px\", { \"lineHeight\": \"20px\", \"fontWeight\": \"400\" }] } } } };</script><style>@layer base{html,body{width:100vw;margin:0;padding:0;background-color:#0f131c;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body-md text-body-md text-on-surface flex flex-col min-h-screen antialiased selection:bg-primary-container selection:text-on-primary-container\"><header class=\"fixed top-0 inset-x-0 z-50 bg-surface-dim/85 backdrop-blur-xl shadow-[0_1px_12px_rgba(0,0,0,0.5)] pt-safe\"><div class=\"h-16 px-margin flex items-center justify-between gap-space-sm\"><div class=\"flex items-center gap-space-sm min-w-0 flex-1\"><img alt=\"Padel Assist Logo\" class=\"h-8 w-auto object-contain shrink-0\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBTcLzVWuV9Pmp8jS1KFA6igMgateNGc2EVpKfH_x6_XYlpldSMwLVboS0R7F6uudnpJWwy3MecOZ19TEt5olh_alcMGcfFeykSTn0t3B7bYrWB-jioiw4Dc3u_SjW6PlVhGZ0OWB8cMZaqcpv7TEy5QyRXK42tmziASoql8aJUHUu92XqpgzouYa29UnNCICgXKu64b09kJkFVskykEQqycm5LHlTHWfHuf1TF1mX07fY6fjSN5c4R\"/><div class=\"flex flex-col min-w-0 justify-center\"><div class=\"flex items-center gap-space-xs\"><span class=\"font-headline-md text-headline-md text-on-surface tracking-tight truncate\">Padel Assist</span><span class=\"font-label-tag text-label-tag px-space-xs py-0.5 rounded-full bg-surface-container-high text-primary tracking-wider uppercase shrink-0\">Pro</span></div><div class=\"flex items-center gap-1.5 mt-0.5\"><span class=\"relative flex h-2 w-2\"><span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span><span class=\"relative inline-flex rounded-full h-2 w-2 bg-primary\"></span></span><span class=\"font-label-tag text-label-tag text-on-surface-variant truncate\">Abierto hoy hasta 11:00 PM</span></div></div></div><div class=\"flex items-center gap-space-sm shrink-0\"><span class=\"sr-only\">Club Info</span><button class=\"relative p-1 rounded-full focus:outline-none focus:ring-2 focus:ring-primary min-h-[44px] min-w-[44px] flex items-center justify-center transition-transform active:scale-95\" type=\"button\"><img alt=\"Profile\" class=\"w-8 h-8 rounded-full object-cover shadow-[0_0_12px_rgba(78,222,163,0.35)]\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAoQl5X_m2cV9bRK7RlnPofFbj31grok4OcvQMhxbj97bNO-T2O68G0UZrYP-AHwkLyL_fRO58jKMvAQ0xbn2TLcGTR1muCm7QhwfiL9M-HbviGaxeqFFYUGi_4-ZzPgIpibfrIIyUgfq2Z_97lo08PoZP32Kve65N4-Fxeh7KILLPamE6jxXT_3Y4HCfNUKZTZ-YuhHB0HZG526gv9NW02LJPREO7WsPBJBoTgvbhlf3Oj7QZyyy9R\"/><span class=\"absolute bottom-1 right-1 w-2.5 h-2.5 bg-primary rounded-full\"></span></button></div></div></header><main class=\"flex-1 flex flex-col relative w-full px-margin pt-16 pb-28 bg-surface\"><div class=\"flex flex-col w-full gap-space-lg select-none\">\n<!-- Dynamic Role Switcher Bar -->\n<div class=\"w-full bg-surface-container-high/90 backdrop-blur-xl p-1.5 rounded-full shadow-lg flex items-center justify-between\">\n<div class=\"relative flex w-full p-0.5 rounded-full bg-surface-container-lowest/80\">\n<div class=\"absolute top-0.5 bottom-0.5 left-0.5 w-[calc(50%-2px)] bg-primary-container rounded-full transition-all duration-300 ease-out shadow-md\" id=\"role-pill-indicator\"></div>\n<button class=\"relative z-10 flex-1 flex items-center justify-center gap-space-xs py-2 px-space-sm rounded-full text-on-primary-container font-label-tag text-label-tag transition-colors duration-200\" id=\"btn-player-mode\" type=\"button\">\n<span class=\"material-symbols-outlined text-[17px]\">sports_tennis</span>\n<span>Vista Jugador</span>\n</button>\n<button class=\"relative z-10 flex-1 flex items-center justify-center gap-space-xs py-2 px-space-sm rounded-full text-on-surface-variant font-label-tag text-label-tag transition-colors duration-200\" id=\"btn-admin-mode\" type=\"button\">\n<span class=\"material-symbols-outlined text-[17px]\">vpn_key</span>\n<span>Modo Canchero</span>\n</button>\n</div>\n</div>\n<!-- VIEW 1: PLAYER MODE CONTENT -->\n<div class=\"flex flex-col gap-space-lg transition-opacity duration-300\" id=\"player-view-container\">\n<!-- Club Location Card with Map Hook -->\n<div class=\"flex flex-col rounded-xl bg-surface-container/70 backdrop-blur-md overflow-hidden shadow-xl\">\n<!-- Location Preview Thumbnail via Map Pipeline -->\n<div class=\"relative w-full h-36 bg-surface-container-lowest\">\n<div class=\"w-full h-full bg-cover bg-center brightness-90\" data-location=\"Club Central Padel &amp; Sport, Av. Los Pinos 1420\" style=\"\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container via-surface-container/20 to-transparent\"></div>\n<div class=\"absolute top-space-sm left-space-sm flex items-center gap-1.5 px-space-xs py-1 rounded-full bg-surface-dim/80 backdrop-blur-md\">\n<span class=\"relative flex h-2 w-2\">\n<span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span>\n<span class=\"relative inline-flex rounded-full h-2 w-2 bg-primary\"></span>\n</span>\n<span class=\"font-label-tag text-label-tag text-primary uppercase\">Canchas Panor\303\241micas</span>\n</div>\n</div>\n<!-- Address Info & Map Action -->\n<div class=\"p-space-md flex flex-col gap-space-sm\">\n<div class=\"flex items-start justify-between gap-space-xs\">\n<div class=\"min-w-0\">\n<h2 class=\"font-headline-md text-headline-md text-on-surface tracking-tight truncate\">Club Central Padel &amp; Sport</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[16px] text-primary shrink-0\">pin_drop</span>\n<span class=\"truncate\">Av. Los Pinos 1420, Sector Los \303\201lamos</span>\n</p>\n</div>\n<span class=\"font-label-numeric-md text-label-numeric-md text-secondary-fixed bg-surface-container-high px-2 py-1 rounded-lg shrink-0\">4.9 \342\230\205</span>\n</div>\n<a class=\"w-full mt-1 flex items-center justify-center gap-space-xs py-2.5 px-space-md rounded-xl bg-surface-container-highest text-on-surface hover:bg-surface-bright active:scale-[0.98] transition-all font-body-md text-body-md shadow-sm\" href=\"https://maps.google.com\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-tertiary text-[18px]\">navigation</span>\n<span class=\"font-medium\">Abrir en Google Maps / Waze</span>\n</a>\n</div>\n</div>\n<!-- Operating Hours Banner -->\n<div class=\"p-space-md rounded-xl bg-surface-container/70 backdrop-blur-md flex items-center justify-between gap-space-sm shadow-md\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">schedule</span>\n</div>\n<div>\n<span class=\"font-label-tag text-label-tag text-on-surface-variant uppercase\">Horarios de Apertura</span>\n<p class=\"font-body-lg text-body-lg text-on-surface font-semibold\">Lun a Dom: 07:00 AM - 11:30 PM</p>\n</div>\n</div>\n<span class=\"font-label-tag text-label-tag px-2 py-0.5 rounded-full bg-primary/20 text-primary uppercase font-bold shrink-0\">Turnos Hoy</span>\n</div>\n<!-- Club Rules & Guidelines (Interactive Accordions) -->\n<div class=\"flex flex-col gap-space-xs\">\n<div class=\"flex items-center justify-between px-1\">\n<h3 class=\"font-headline-md text-headline-md text-on-surface\">Normas y Servicios</h3>\n<span class=\"font-label-tag text-label-tag text-on-surface-variant\">Reglamento 2025</span>\n</div>\n<!-- Rule 1: Footwear -->\n<div class=\"rule-accordion overflow-hidden rounded-xl bg-surface-container/60 backdrop-blur-sm transition-all duration-300\">\n<button class=\"rule-toggle w-full p-space-md flex items-center justify-between text-left gap-space-sm\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[22px] shrink-0\">sports_score</span>\n<span class=\"font-body-lg text-body-lg text-on-surface font-medium truncate\">Uso obligatorio de suela espiga</span>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant transition-transform duration-200 chevron-icon\">expand_more</span>\n</button>\n<div class=\"rule-content max-h-0 overflow-hidden transition-all duration-300 px-space-md pb-0 text-on-surface-variant\">\n<div class=\"pb-space-md text-body-md font-body-md\">\n            Para preservar la fibra sint\303\251tica y garantizar la tracci\303\263n segura en c\303\251sped monofilamento con arena, no se admiten zapatillas running o con suela de tacos agresivos. El club dispone de alquiler en pro-shop.\n          </div>\n</div>\n</div>\n<!-- Rule 2: Cancellations -->\n<div class=\"rule-accordion overflow-hidden rounded-xl bg-surface-container/60 backdrop-blur-sm transition-all duration-300\">\n<button class=\"rule-toggle w-full p-space-md flex items-center justify-between text-left gap-space-sm\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[22px] shrink-0\">event_available</span>\n<span class=\"font-body-lg text-body-lg text-on-surface font-medium truncate\">Cancelaciones gratuitas hasta 4h antes</span>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant transition-transform duration-200 chevron-icon\">expand_more</span>\n</button>\n<div class=\"rule-content max-h-0 overflow-hidden transition-all duration-300 px-space-md pb-0 text-on-surface-variant\">\n<div class=\"pb-space-md text-body-md font-body-md\">\n            Puedes reprogramar o anular tu reserva con reintegro \303\255ntegro a tu billetera de la app con un margen de al menos 4 horas previas al partido. Fuera de ese lapso se cargar\303\241 el dep\303\263sito de pista.\n          </div>\n</div>\n</div>\n<!-- Rule 3: Pro-Shop / Rentals -->\n<div class=\"rule-accordion overflow-hidden rounded-xl bg-surface-container/60 backdrop-blur-sm transition-all duration-300\">\n<button class=\"rule-toggle w-full p-space-md flex items-center justify-between text-left gap-space-sm\" type=\"button\">\n<div class=\"flex items-center gap-space-sm min-w-0\">\n<span class=\"material-symbols-outlined text-primary text-[22px] shrink-0\">inventory_2</span>\n<span class=\"font-body-lg text-body-lg text-on-surface font-medium truncate\">Alquiler de palas &amp; Pro-Shop Oficial</span>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant transition-transform duration-200 chevron-icon\">expand_more</span>\n</button>\n<div class=\"rule-content max-h-0 overflow-hidden transition-all duration-300 px-space-md pb-0 text-on-surface-variant\">\n<div class=\"pb-space-md text-body-md font-body-md\">\n            En recepci\303\263n encontrar\303\241s palas de test Bullpadel y Head ($3.500 / turno), tubos de pelotas presurizadas nuevas, overgrips y servicio de encordado r\303\241pido.\n          </div>\n</div>\n</div>\n</div>\n<!-- Visual Amenity Teasers -->\n<div class=\"grid grid-cols-2 gap-space-sm\">\n<div class=\"rounded-xl overflow-hidden bg-surface-container/70 p-space-sm flex flex-col gap-2\">\n<div class=\"w-full h-20 rounded-lg overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A modern padel club illuminated panoramic glass court at twilight with neon green led highlights and lush emerald turf in cyber-athletic architectural photography style\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBl6wkhx3wYfsO3VPDrcRk4eJ3C107IXc-GxMnthnsJxQnODVWA9ebsl36f96ewCRST0IDfCwxF9lLb-lBTFVkPPUqBZhslwYe2-ZTpRcQB3FB_QJZrfa_QlqVWhmrr5_b2RkUYGs_LHUSpWkwoheqKme9vUs10PA3Z6w_pCEAZBIrIJYqHMUpUgyOKnXwgHxc0sEp_bd4UUphEEtVqtQL4Kk-XZadFRUqiWhN6wf85BmN1NOwNP6-t\"/>\n</div>\n<div>\n<h4 class=\"font-body-md text-body-md font-semibold text-on-surface\">5 Canchas Cristal</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Iluminaci\303\263n LED World Padel Tour</p>\n</div>\n</div>\n<div class=\"rounded-xl overflow-hidden bg-surface-container/70 p-space-sm flex flex-col gap-2\">\n<div class=\"w-full h-20 rounded-lg overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A contemporary sports club lounge bar area with modern minimalist dark metal counter and comfortable athletic leather seating bathed in warm ambient lighting\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCWpTyd8k6uvoC9Y_UyYHg-vg36HN3UTuFiqIopsw5ChrtTGWZJIihQtdHmD91Hsv2bN37hMip6O3fSqBg0hCNag3ye4D6wFygsaFjmdTGKNSNaJUz1FxMJANqJK4aCdxKwe5UfYLbzJyA9gMgdf7-eYNIp9OPutTUQHsgqehBOHZkXVJMIfa-Q-E-MzZXPdt4Q1scjLey8trJQ3QS5t37cRjIoKIjdKkawIeMQ3IU_o33xGyl_SVqI\"/>\n</div>\n<div>\n<h4 class=\"font-body-md text-body-md font-semibold text-on-surface\">Quincho &amp; 3er Tiempo</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Cafeter\303\255a de especialidad y bebidas</p>\n</div>\n</div>\n</div>\n<!-- Floating Persistent WhatsApp Trigger with Glow Pulse -->\n<div class=\"pt-2\">\n<a class=\"relative group w-full py-3.5 px-space-lg rounded-xl bg-surface-container-high hover:bg-surface-bright active:scale-[0.98] transition-all flex items-center justify-between shadow-xl\" href=\"https://wa.me/5491100000000?text=Hola%20Padel%20Assist,%20tengo%20una%20consulta\" rel=\"noopener noreferrer\" target=\"_blank\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"relative flex items-center justify-center w-10 h-10 rounded-full bg-primary-container text-on-primary-container shadow-md\">\n<span class=\"material-symbols-outlined text-[22px]\">chat</span>\n<span class=\"animate-ping absolute -top-0.5 -right-0.5 h-3.5 w-3.5 rounded-full bg-primary opacity-60\"></span>\n<span class=\"absolute -top-0.5 -right-0.5 h-3.5 w-3.5 rounded-full bg-primary\"></span>\n</div>\n<div>\n<h4 class=\"font-body-lg text-body-lg font-bold text-on-surface\">Hablar con Recepci\303\263n</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Atenci\303\263n directa del Canchero por WhatsApp</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-primary text-[20px] transition-transform group-hover:translate-x-1\">arrow_forward_ios</span>\n</a>\n</div>\n</div>\n<!-- VIEW 2: ADMIN / CANCHERO MODE CONTENT (Hidden by default, shown via toggle) -->\n<div class=\"hidden flex flex-col gap-space-lg transition-opacity duration-300\" id=\"admin-view-container\">\n<!-- Admin Hero Banner -->\n<div class=\"relative p-space-md rounded-xl bg-gradient-to-br from-surface-container-high to-surface-container overflow-hidden shadow-xl\">\n<div class=\"absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-primary/10 blur-2xl pointer-events-none\"></div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"material-symbols-outlined text-primary text-[22px]\">bolt</span>\n<span class=\"font-headline-md text-headline-md text-on-surface\">Panel R\303\241pido Canchero</span>\n</div>\n<span class=\"font-label-tag text-label-tag px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container uppercase\">En Turno</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Supervisi\303\263n en tiempo real de pistas, cobros en mostrador y bloqueos inmediatos.</p>\n</div>\n<!-- Active Turn / Pending Payment Card -->\n<div class=\"flex flex-col gap-space-sm p-space-md rounded-xl bg-surface-container/80 backdrop-blur-md shadow-xl\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-tertiary\"></span>\n<span class=\"font-label-tag text-label-tag text-tertiary uppercase\">Turno Entrante</span>\n</div>\n<span class=\"font-label-numeric-md text-label-numeric-md text-on-surface-variant\">18:00 - 19:30</span>\n</div>\n<div class=\"flex items-center justify-between gap-space-sm pt-1\">\n<div>\n<div class=\"flex items-center gap-2\">\n<span class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface font-extrabold tracking-tight\">Pista 1</span>\n<span class=\"font-label-tag text-label-tag px-2 py-0.5 rounded-full bg-surface-container-highest text-primary\">Cristal Pro</span>\n</div>\n<p class=\"font-body-md text-body-md text-on-surface font-medium mt-0.5\">Carlos Mendoza</p>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">4 Jugadores \302\267 Se\303\261a pendiente: $12.000</p>\n</div>\n<div class=\"w-12 h-12 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface shrink-0\">\n<span class=\"material-symbols-outlined text-[26px] text-tertiary\">group</span>\n</div>\n</div>\n<!-- Quick Contact Actions -->\n<div class=\"grid grid-cols-2 gap-space-xs mt-1\">\n<a class=\"py-2.5 px-space-sm rounded-lg bg-surface-container-highest flex items-center justify-center gap-space-xs text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" href=\"tel:+5491144445555\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">call</span>\n<span class=\"font-body-sm text-body-sm font-semibold\">Llamar</span>\n</a>\n<a class=\"py-2.5 px-space-sm rounded-lg bg-surface-container-highest flex items-center justify-center gap-space-xs text-on-surface hover:bg-surface-bright active:scale-95 transition-all\" href=\"https://wa.me/5491144445555?text=Hola%20Carlos,%20te%20escribimos%20de%20la%20cancha%20por%20tu%20turno%20de%2018:00\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">chat</span>\n<span class=\"font-body-sm text-body-sm font-semibold\">WhatsApp</span>\n</a>\n</div>\n<!-- Swipe / Interactive Slider to Confirm Payment -->\n<div class=\"mt-2 flex flex-col gap-1.5\">\n<span class=\"font-label-tag text-label-tag text-on-surface-variant uppercase tracking-wider\">Validaci\303\263n de Turno en Mesa</span>\n<div class=\"relative w-full h-14 rounded-full bg-surface-container-lowest overflow-hidden flex items-center select-none shadow-inner\" id=\"swipe-track\">\n<div class=\"absolute inset-y-0 left-0 bg-primary-container/40 w-0 transition-all duration-75\" id=\"swipe-progress\"></div>\n<div class=\"w-full text-center font-label-tag text-label-tag text-on-surface-variant font-bold uppercase tracking-wider pointer-events-none transition-opacity duration-200\" id=\"swipe-text\">\n            Desliza para Confirmar Pago\n          </div>\n<!-- Handle -->\n<div class=\"absolute left-1 top-1 bottom-1 w-12 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shadow-lg cursor-grab active:cursor-grabbing transition-transform touch-none\" id=\"swipe-thumb\">\n<span class=\"material-symbols-outlined text-[24px]\" id=\"swipe-icon\">double_arrow</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Lock Slot Button / Maintenance Immediate Modal Trigger -->\n<div class=\"flex flex-col gap-space-xs\">\n<button class=\"w-full py-3.5 px-space-md rounded-xl bg-surface-container-high hover:bg-surface-bright active:scale-[0.98] transition-all flex items-center justify-between shadow-md\" id=\"btn-block-slot\" type=\"button\">\n<div class=\"flex items-center gap-space-sm\">\n<div class=\"w-10 h-10 rounded-full bg-error-container text-on-error-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">lock_clock</span>\n</div>\n<div class=\"text-left\">\n<h4 class=\"font-body-lg text-body-lg font-bold text-on-surface\">+ Congelar / Bloquear Horario</h4>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Mantenimiento, lluvia o turno telef\303\263nico</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant text-[20px]\">chevron_right</span>\n</button>\n<!-- Quick Day Stats for Club Manager -->\n<div class=\"grid grid-cols-3 gap-space-xs mt-1\">\n<div class=\"p-space-sm rounded-xl bg-surface-container/60 text-center flex flex-col\">\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-primary font-bold\">14/16</span>\n<span class=\"font-label-tag text-label-tag text-on-surface-variant uppercase mt-0.5\">Turnos Hoy</span>\n</div>\n<div class=\"p-space-sm rounded-xl bg-surface-container/60 text-center flex flex-col\">\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-secondary-fixed font-bold\">$184k</span>\n<span class=\"font-label-tag text-label-tag text-on-surface-variant uppercase mt-0.5\">Caja D\303\255a</span>\n</div>\n<div class=\"p-space-sm rounded-xl bg-surface-container/60 text-center flex flex-col\">\n<span class=\"font-label-numeric-lg text-label-numeric-lg text-tertiary font-bold\">100%</span>\n<span class=\"font-label-tag text-label-tag text-on-surface-variant uppercase mt-0.5\">Luz Pistas</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Modal Sheet: Block Slot Simulation (Hidden initially) -->\n<div class=\"fixed inset-0 z-50 bg-surface-dim/80 backdrop-blur-md hidden items-end justify-center p-space-sm\" id=\"block-modal\">\n<div class=\"w-full max-w-lg rounded-2xl bg-surface-container-high p-space-lg shadow-2xl flex flex-col gap-space-md\">\n<div class=\"w-10 h-1 bg-surface-variant rounded-full mx-auto mb-1\"></div>\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-md text-headline-md text-on-surface\">Bloqueo de Cancha</h3>\n<button class=\"w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant\" id=\"btn-close-modal\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">close</span>\n</button>\n</div>\n<div class=\"flex flex-col gap-space-sm\">\n<label class=\"font-label-tag text-label-tag text-on-surface-variant uppercase\">Pista Destino</label>\n<div class=\"grid grid-cols-3 gap-2\">\n<button class=\"py-2 rounded-lg bg-primary-container text-on-primary-container font-semibold font-body-sm text-body-sm\" type=\"button\">Pista 1</button>\n<button class=\"py-2 rounded-lg bg-surface-container text-on-surface font-body-sm text-body-sm\" type=\"button\">Pista 2</button>\n<button class=\"py-2 rounded-lg bg-surface-container text-on-surface font-body-sm text-body-sm\" type=\"button\">Pista 3</button>\n</div>\n<label class=\"font-label-tag text-label-tag text-on-surface-variant uppercase mt-2\">Motivo del Bloqueo</label>\n<div class=\"flex flex-col gap-2\">\n<button class=\"p-2.5 rounded-lg bg-surface-container text-left text-on-surface font-body-md text-body-md flex items-center justify-between\" type=\"button\">\n<span>\360\237\224\247 Mantenimiento / Cepillado de Pelo</span>\n<span class=\"material-symbols-outlined text-[16px] text-primary\">check</span>\n</button>\n<button class=\"p-2.5 rounded-lg bg-surface-container text-left text-on-surface-variant font-body-md text-body-md\" type=\"button\">\n<span>\360\237\227\243\357\270\217 Turno Reservado por Tel\303\251fono / Mostrador</span>\n</button>\n</div>\n</div>\n<button class=\"w-full py-3 rounded-xl bg-error text-on-error font-body-lg text-body-lg font-bold shadow-md active:scale-98 transition-all\" id=\"btn-confirm-block\" type=\"button\">\n        Confirmar Bloqueo Inmediato\n      </button>\n</div>\n</div>\n</div>\n<script>\n  // Dynamic Tab Switcher (Player vs Canchero Mode)\n  const btnPlayer = document.getElementById(\'btn-player-mode\');\n  const btnAdmin = document.getElementById(\'btn-admin-mode\');\n  const indicator = document.getElementById(\'role-pill-indicator\');\n  const playerView = document.getElementById(\'player-view-container\');\n  const adminView = document.getElementById(\'admin-view-container\');\n\n  btnPlayer.addEventListener(\'click\', () => {\n    indicator.style.transform = \'translateX(0)\';\n    btnPlayer.classList.add(\'text-on-primary-container\');\n    btnPlayer.classList.remove(\'text-on-surface-variant\');\n    btnAdmin.classList.add(\'text-on-surface-variant\');\n    btnAdmin.classList.remove(\'text-on-primary-container\');\n    \n    playerView.classList.remove(\'hidden\');\n    adminView.classList.add(\'hidden\');\n  });\n\n  btnAdmin.addEventListener(\'click\', () => {\n    indicator.style.transform = \'translateX(100%)\';\n    btnAdmin.classList.add(\'text-on-primary-container\');\n    btnAdmin.classList.remove(\'text-on-surface-variant\');\n    btnPlayer.classList.add(\'text-on-surface-variant\');\n    btnPlayer.classList.remove(\'text-on-primary-container\');\n\n    adminView.classList.remove(\'hidden\');\n    playerView.classList.add(\'hidden\');\n  });\n\n  // Accordion Expand/Collapse Logic\n  document.querySelectorAll(\'.rule-toggle\').forEach(button => {\n    button.addEventListener(\'click\', () => {\n      const accordion = button.parentElement;\n      const content = accordion.querySelector(\'.rule-content\');\n      const chevron = button.querySelector(\'.chevron-icon\');\n      const isOpen = content.style.maxHeight && content.style.maxHeight !== \'0px\';\n\n      document.querySelectorAll(\'.rule-content\').forEach(c => c.style.maxHeight = \'0px\');\n      document.querySelectorAll(\'.chevron-icon\').forEach(i => i.style.transform = \'rotate(0deg)\');\n\n      if (!isOpen) {\n        content.style.maxHeight = content.scrollHeight + \'px\';\n        chevron.style.transform = \'rotate(180deg)\';\n      }\n    });\n  });\n\n  // Swipe to Confirm Interactive Slider\n  const thumb = document.getElementById(\'swipe-thumb\');\n  const track = document.getElementById(\'swipe-track\');\n  const progress = document.getElementById(\'swipe-progress\');\n  const swipeText = document.getElementById(\'swipe-text\');\n  const swipeIcon = document.getElementById(\'swipe-icon\');\n\n  let isDragging = false;\n  let startX = 0;\n  let maxDistance = 0;\n\n  function updateMaxDistance() {\n    maxDistance = track.clientWidth - thumb.clientWidth - 8;\n  }\n  updateMaxDistance();\n  window.addEventListener(\'resize\', updateMaxDistance);\n\n  function onPointerDown(e) {\n    if (thumb.dataset.confirmed === \'true\') return;\n    isDragging = true;\n    startX = e.clientX || (e.touches && e.touches[0].clientX);\n    thumb.style.transition = \'none\';\n    progress.style.transition = \'none\';\n  }\n\n  function onPointerMove(e) {\n    if (!isDragging) return;\n    const currentX = e.clientX || (e.touches && e.touches[0].clientX);\n    let delta = currentX - startX;\n    delta = Math.max(0, Math.min(delta, maxDistance));\n\n    thumb.style.transform = `translateX(${delta}px)`;\n    progress.style.width = `${delta + thumb.clientWidth}px`;\n\n    const opacity = 1 - (delta / maxDistance);\n    swipeText.style.opacity = opacity.toString();\n\n    if (delta >= maxDistance - 4) {\n      confirmSwipe();\n    }\n  }\n\n  function onPointerUp() {\n    if (!isDragging) return;\n    isDragging = false;\n    thumb.style.transition = \'transform 0.25s ease-out\';\n    progress.style.transition = \'width 0.25s ease-out\';\n\n    if (thumb.dataset.confirmed !== \'true\') {\n      thumb.style.transform = \'translateX(0px)\';\n      progress.style.width = \'0px\';\n      swipeText.style.opacity = \'1\';\n    }\n  }\n\n  function confirmSwipe() {\n    isDragging = false;\n    thumb.dataset.confirmed = \'true\';\n    thumb.style.transform = `translateX(${maxDistance}px)`;\n    thumb.classList.remove(\'bg-primary-container\', \'text-on-primary-container\');\n    thumb.classList.add(\'bg-primary\', \'text-on-primary\');\n    swipeIcon.textContent = \'check\';\n    swipeText.textContent = \'\302\241Pago Validado con \303\211xito!\';\n    swipeText.style.opacity = \'1\';\n    swipeText.classList.remove(\'text-on-surface-variant\');\n    swipeText.classList.add(\'text-primary\');\n    progress.style.width = \'100%\';\n  }\n\n  thumb.addEventListener(\'mousedown\', onPointerDown);\n  thumb.addEventListener(\'touchstart\', onPointerDown, { passive: true });\n  window.addEventListener(\'mousemove\', onPointerMove);\n  window.addEventListener(\'touchmove\', onPointerMove, { passive: true });\n  window.addEventListener(\'mouseup\', onPointerUp);\n  window.addEventListener(\'touchend\', onPointerUp);\n\n  // Block Modal Interactions\n  const blockModal = document.getElementById(\'block-modal\');\n  const btnBlockSlot = document.getElementById(\'btn-block-slot\');\n  const btnCloseModal = document.getElementById(\'btn-close-modal\');\n  const btnConfirmBlock = document.getElementById(\'btn-confirm-block\');\n\n  btnBlockSlot.addEventListener(\'click\', () => {\n    blockModal.classList.remove(\'hidden\');\n    blockModal.classList.add(\'flex\');\n  });\n\n  btnCloseModal.addEventListener(\'click\', () => {\n    blockModal.classList.add(\'hidden\');\n    blockModal.classList.remove(\'flex\');\n  });\n\n  btnConfirmBlock.addEventListener(\'click\', () => {\n    btnConfirmBlock.textContent = \'Slot Congelado\';\n    setTimeout(() => {\n      blockModal.classList.add(\'hidden\');\n      blockModal.classList.remove(\'flex\');\n      btnConfirmBlock.textContent = \'Confirmar Bloqueo Inmediato\';\n    }, 600);\n  });\n</script></main><nav class=\"fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface-container-lowest/85 backdrop-blur-2xl shadow-[0_-8px_24px_rgba(0,0,0,0.6)]\" data-active-classes=\"text-primary font-semibold [&amp;_.active-pill]:scale-100 [&amp;_.active-pill]:opacity-100 [&amp;_.nav-icon]:translate-y-[-2px]\"><div class=\"grid grid-cols-4 items-center h-20 px-space-xs\"><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"canchas\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">sports_tennis</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Canchas</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"reservar\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">edit_calendar</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Reservar</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] text-on-surface-variant transition-all duration-300 hover:text-on-surface active:scale-95\" data-path=\"mis-partidos\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">confirmation_number</span><span class=\"absolute -top-1 -right-1 flex h-2.5 w-2.5\"><span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75\"></span><span class=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-primary\"></span></span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Partidos</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a><a aria-current=\"page\" class=\"group relative flex flex-col items-center justify-center gap-1 h-full min-h-[44px] transition-all duration-300 active:scale-95 text-primary font-semibold [&amp;_.active-pill]:scale-100 [&amp;_.active-pill]:opacity-100 [&amp;_.nav-icon]:translate-y-[-2px]\" data-path=\"club-info\" href=\"#\"><div class=\"relative flex items-center justify-center\"><span class=\"material-symbols-outlined nav-icon transition-transform duration-300\">domain</span></div><span class=\"font-label-tag text-label-tag tracking-wider truncate\">Club</span><span class=\"active-pill absolute bottom-1.5 w-1.5 h-1.5 rounded-full bg-primary opacity-0 scale-50 transition-all duration-300 shadow-[0_0_8px_#4edea3]\"></span></a></div></nav></body></html>"
