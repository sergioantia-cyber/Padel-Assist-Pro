      name: "write_to_file"
      arguments_json: "{\"Append\":true, \"CodeContent\":\"\\n-- ====================================================================\\n-- 6. FUNCI\303\223N DE DISPONIBILIDAD HORARIA (SECURITY DEFINER)\\n-- ====================================================================\\nCREATE OR REPLACE FUNCTION get_available_slots(\\n    p_court_id UUID,\\n    p_date DATE,\\n    p_slot_duration_minutes INT DEFAULT 90\\n)\\nRETURNS TABLE (slot_start TIMESTAMPTZ, slot_end TIMESTAMPTZ, is_available BOOLEAN) \\nLANGUAGE plpgsql\\nSECURITY DEFINER\\nAS $$\\nDECLARE\\n    club_open TIME := \'07:00:00\';\\n    club_close TIME := \'23:00:00\';\\n    curr_slot_start TIMESTAMPTZ;\\n    curr_slot_end TIMESTAMPTZ;\\nBEGIN\\n    curr_slot_start := (p_date + club_open)::TIMESTAMPTZ;\\n    \\n    WHILE (curr_slot_start + (p_slot_duration_minutes || \' minutes\')::INTERVAL) <= (p_date + club_close)::TIMESTAMPTZ LOOP\\n        curr_slot_end := curr_slot_start + (p_slot_duration_minutes || \' minutes\')::INTERVAL;\\n        \\n        RETURN QUERY\\n        SELECT \\n            curr_slot_start,\\n            curr_slot_end,\\n            NOT EXISTS (\\n                SELECT 1 FROM bookings b\\n                WHERE b.court_id = p_court_id\\n                  AND b.status IN (\'confirmed\', \'pending_payment\')\\n                  AND (b.start_time < curr_slot_end AND b.end_time > curr_slot_start)\\n            );\\n            \\n        curr_slot_start := curr_slot_end;\\n    END LOOP;\\nEND;\\n$$;\\n\", \"Description\":\"Append get_available_slots function to src/db/schema.sql\", \"Overwrite\":false, \"TargetFile\":\"/src/db/schema.sql\", \"toolAction\":\"Updating schema.sql\", \"toolSummary\":\"Append get_available_slots to schema.sql\"}"
      thinking_signature: "\022\306\001\n\303\001\001i\024}\023\354\345\333)\354oo\002]V\324[\244\315\3671 \327<\fu\000rM\245\'\273\231$\005\334\212\272\225\257\b\317\226\v\235\027\243sdB\017\032\033]7\275\177\350e\217\342k\365S\212}\264B\237qg6\353p{o\036\226\344S\3212_7\337\223v\334\275oePa\335h\307\336\r\003\333\333\354\006\374\214\030_ $-+\033\236\242\313\'\t(N6\303t\317*\243\024\315\251\252\366r\347\354\241^\243\207\212^DZ\326\347\017\202\257\207\r\020\327j\035\213w\277\332\200H\016*Vw\347\235\233\203\365\243\251\036}\"4\312l\324E\351\200q.\322\320F*\306\351\323\337\207\211\311\201P\376"
